# ─────────────────────────────────────────────────────────────────────────────
# LLM backend — OpenAI-compatible chat/completions.
# Two supported modes: a local llama.cpp server, or OpenRouter (cloud).
# If the simulation can't reach the endpoint it falls back to rule-based logic.
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: LOCAL llama.cpp server (e.g. Qwen3-8B GGUF) ────────────────────
# The server is OpenAI-compatible, so point the base URL at its /v1 endpoint.
# Any non-empty API key works (the local server ignores it, but the app uses
# a non-empty key as the "LLM enabled" signal).
OPENROUTER_API_KEY=local
OPENROUTER_BASE_URL=http://10.0.0.134:9090/v1/chat/completions
OPENROUTER_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M

# ── Option B: OpenRouter (cloud) ─────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys, then use something like:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=google/gemini-2.5-flash   # or qwen/qwen-3-8b, google/gemma-3-12b-it

# Optional: your site URL & app name (OpenRouter analytics; ignored locally)
OPENROUTER_SITE_URL=https://github.com/leatag/emergent-city
OPENROUTER_APP_NAME=EmergentCity
